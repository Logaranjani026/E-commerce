# ==========================================
# SmartCart AI - Environment Configuration
# ==========================================

# Secret Keys for Session & JWT Token Auth
SECRET_KEY=smartcart-ai-super-secret-jwt-key-2026
JWT_SECRET_KEY=smartcart-jwt-auth-token-key-2026
JWT_EXPIRES_HOURS=72

# Database Mode
# Set USE_MYSQL=true to use MySQL server, or false to use zero-config SQLite
USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smartcart_db

# AI API Key (Optional: If left blank, built-in intelligent NLP heuristic engine runs automatically!)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port
PORT=5000
